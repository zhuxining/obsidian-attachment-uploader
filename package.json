{
  "name": "attachment-uploader",
  "version": "1.1.0",
  "description": "Attachment uploader plugin, which allows you customize the upload command, customize upload file type.",
  "keywords": [],
  "license": "MIT",
  "author": "zhuxining",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuxining/obsidian-attachment-uploader"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node --no-warnings esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "check": "vp check --fix",
    "test": "vp test run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.25.12",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core",
    "vite-plus": "0.2.7"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
